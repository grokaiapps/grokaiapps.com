      "networkId": "profile_61VWqT6yAHyjIP6EJA6VWqT668SQipSDos48kYNEeAxc",
      "stripe_profile": "@autogrokdesk",
      "returns": "entitlement_key (agk.…) for X-Entitlement-Key on /v1/jobs/* and /mcp",
      "top_up": "send existing X-Entitlement-Key with the purchase",
      "scope": "packs only ($0.50–$0.60 card minimum); per-call stays on x402"
